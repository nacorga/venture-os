{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VentureState",
  "type": "object",
  "required": [
    "version",
    "name",
    "slug",
    "stage",
    "thesis",
    "assumptions",
    "evidence_index",
    "next_action"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1, 2]
    },
    "name": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "stage": {
      "enum": ["concept", "research", "validation", "positioning", "experiment", "learning", "build", "parked"]
    },
    "thesis": {
      "type": "object",
      "required": ["problem", "icp", "solution", "business_model", "distribution"]
    },
    "assumptions": { "type": "array" },
    "evidence_index": { "type": "array" },
    "latest_decision": { "type": "object" },
    "blocking_assumptions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^A[0-9]{3,}$" }
    },
    "blocking_deferrals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption_id", "reason"],
        "properties": {
          "assumption_id": { "type": "string", "pattern": "^A[0-9]{3,}$" },
          "reason": { "type": "string", "minLength": 1 },
          "until": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "next_action": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["id", "type", "assumption_id", "instruction", "success_signal", "failure_signal"],
          "properties": {
            "id": { "type": "string", "pattern": "^N[0-9]{3,}$" },
            "type": { "enum": ["normalize", "research", "challenge", "decision", "experiment", "outreach", "positioning", "build", "other"] },
            "assumption_id": { "type": ["string", "null"], "pattern": "^A[0-9]{3,}$" },
            "instruction": { "type": "string" },
            "success_signal": { "type": ["string", "null"] },
            "failure_signal": { "type": ["string", "null"] },
            "depends_on": {
              "type": "array",
              "items": { "type": "string", "pattern": "^N[0-9]{3,}$" }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "do_not_build": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["id", "statement"],
            "properties": {
              "id": { "type": "string", "pattern": "^DNB[0-9]{3,}$" },
              "statement": { "type": "string" },
              "reason": { "type": ["string", "null"] },
              "evidence_ids": {
                "type": "array",
                "items": { "type": "string", "pattern": "^E[0-9]{3,}$" }
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "revisit_when": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["id", "condition"],
            "properties": {
              "id": { "type": "string", "pattern": "^T[0-9]{3,}$" },
              "condition": { "type": "string" },
              "check": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "reopen_combination_rule": {
      "type": ["object", "null"],
      "properties": {
        "all_of": {
          "type": "array",
          "items": { "type": "string", "pattern": "^T[0-9]{3,}$" }
        },
        "any_of": {
          "type": "array",
          "items": { "type": "string", "pattern": "^T[0-9]{3,}$" }
        },
        "note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 2 } } },
      "then": {
        "properties": {
          "next_action": { "type": "object" },
          "blocking_deferrals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["assumption_id", "reason"]
            }
          },
          "do_not_build": {
            "items": {
              "type": "object",
              "required": ["id", "statement"]
            }
          },
          "revisit_when": {
            "items": {
              "type": "object",
              "required": ["id", "condition"]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
