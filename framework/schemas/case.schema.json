{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venture-os.dev/schemas/case-v1.schema.json",
  "title": "Venture OS Case v1",
  "description": "Portable, publishable input contract for a Venture OS case. Evaluator expectations and scoring metadata are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "statement",
    "categories",
    "tags",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "statement": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000,
      "description": "Self-contained venture or problem statement presented to Venture OS. It must not contain evaluator hints or expected conclusions."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "b2b-saas",
          "b2c-saas",
          "consumer-subscription",
          "marketplace",
          "ecommerce",
          "physical-product",
          "developer-tool",
          "service-business",
          "content-media",
          "platform",
          "other"
        ]
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 2,
          "maxLength": 240
        },
        "geography": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "business_model_notes": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "constraints": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 240
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["synthetic", "anonymized-real", "public-real"]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {"const": "public-real"}
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "source_url": {}
            },
            "required": ["source_url"]
          }
        }
      ]
    }
  }
}
