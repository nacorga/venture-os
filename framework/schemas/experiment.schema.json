{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "status",
    "primary_assumption_id",
    "procedure",
    "signals",
    "decision_rules"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^X[0-9]{3,}$"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "designed",
        "running",
        "completed",
        "cancelled"
      ]
    },
    "primary_assumption_id": {
      "type": "string"
    },
    "procedure": {
      "type": "array"
    },
    "signals": {
      "type": "object"
    },
    "decision_rules": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
